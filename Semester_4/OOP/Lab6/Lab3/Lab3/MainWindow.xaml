<Window x:Class="Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор" Height="700" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="LightGray">
            <Label Content="Фигура для создания:" Margin="5"/>
            <ComboBox x:Name="FigureComboBox" Margin="5"/>

            <Label Content="Редактирование:" Margin="5,15,5,5"/>
            <StackPanel Margin="5" Orientation="Horizontal">
                <Label Content="X1:" Width="25"/>
                <TextBox x:Name="StartXBox" Width="50"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <Label Content="Y1:" Width="25"/>
                <TextBox x:Name="StartYBox" Width="50"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <Label Content="X2:" Width="25"/>
                <TextBox x:Name="EndXBox" Width="50"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <Label Content="Y2:" Width="25"/>
                <TextBox x:Name="EndYBox" Width="50"/>
            </StackPanel>

            <Button x:Name="UpdateButton" Content="Обновить фигуру" Margin="5" Click="UpdateButton_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить фигуру" Margin="5" Click="DeleteButton_Click"/>

            <Label Content="Список фигур:" Margin="5,15,5,5"/>
            <ListBox x:Name="FiguresListBox" Height="120" Margin="5" SelectionChanged="FiguresListBox_SelectionChanged"/>

            <Label Content="Обработчик данных:" Margin="5,5,5,0"/>
            <ComboBox x:Name="ProcessorComboBox" Margin="5"/>
            <Button x:Name="SettingsButton" Content="Настройки плагина" Margin="5" Click="SettingsButton_Click"/>

            <Button x:Name="SaveButton" Content="Сохранить в файл" Margin="5" Click="SaveButton_Click"/>
            <Button x:Name="LoadButton" Content="Загрузить из файла" Margin="5" Click="LoadButton_Click"/>
        </StackPanel>

        <Canvas x:Name="DrawCanvas" Grid.Column="1" Background="White"
                MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"/>
    </Grid>
</Window>