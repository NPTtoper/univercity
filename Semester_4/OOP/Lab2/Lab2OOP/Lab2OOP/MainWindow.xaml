<Window x:Class="GraphicEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graphic Editor" Height="650" Width="950">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Shapes">
                <MenuItem Header="Basic" x:Name="mnuBasic"/>
                <Separator/>
                <MenuItem Header="Plugins" x:Name="mnuPlugins"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Clear All" Click="ClearAll"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="lblStatus" Text="Ready"/>
        </StatusBar>

        <ListBox x:Name="lstShapes" DockPanel.Dock="Right" Width="220" SelectionChanged="LstShapes_SelectionChanged"/>

        <ScrollViewer DockPanel.Dock="Left" Width="150" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="buttonsPanel" Margin="5"/>
        </ScrollViewer>

        <Border BorderBrush="Gray" BorderThickness="2" Margin="5" Background="White">
            <Canvas x:Name="canvas" Background="Transparent" 
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
        </Border>
    </DockPanel>
</Window>