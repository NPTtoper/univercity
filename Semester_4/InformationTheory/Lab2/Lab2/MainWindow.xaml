<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Регистр -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Состояние регистра (27 бит):" FontWeight="Bold"/>
            <TextBox x:Name="RegisterTextBox" Height="25" Margin="0,0,0,5" 
                     TextChanged="RegisterTextBox_TextChanged"/>
            <TextBlock x:Name="LengthLabel" Text="Введено бит: 0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Открыть файл" Width="100" Margin="0,0,10,0" Click="OpenFile_Click"/>
            <Button Content="Шифровать/Дешифровать" Width="150" Margin="0,0,10,0" Click="EncryptButton_Click"/>
            <Button Content="Сохранить файл" Width="100" Margin="0,0,10,0" Click="SaveFile_Click"/>
            <Button Content="Очистить" Width="80" Click="ClearButton_Click"/>
        </StackPanel>

        <!-- Ключ -->
        <GroupBox Grid.Row="2" Header="Ключ" Margin="0,0,0,10">
            <TextBox x:Name="KeyTextBox" Height="60" IsReadOnly="True" 
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <!-- Исходный файл -->
        <GroupBox Grid.Row="3" Header="Исходный файл (двоичный вид)" Margin="0,0,0,10">
            <TextBox x:Name="PlainTextBox" Height="100" IsReadOnly="True" 
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <!-- Зашифрованный файл -->
        <GroupBox Grid.Row="4" Header="Зашифрованный файл (двоичный вид)" Margin="0,0,0,10">
            <TextBox x:Name="CipherTextBox" Height="100" IsReadOnly="True" 
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
    </Grid>
</Window>
